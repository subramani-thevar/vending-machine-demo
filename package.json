{
  "name": "vending-machine-demo",
  "version": "1.0.0",
  "description": "Interactive 3D Vending Machine Demo with QR scanning and real-time sync",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ tests/ --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.21.0",
    "express-rate-limit": "7.4.1",
    "helmet": "7.1.0",
    "morgan": "1.10.0",
    "qrcode": "1.5.4",
    "socket.io": "4.7.5",
    "uuid": "9.0.1",
    "winston": "3.14.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@react-three/drei": "9.114.0",
    "@react-three/fiber": "8.17.9",
    "@testing-library/react": "14.3.1",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/morgan": "1.9.9",
    "@types/node": "20.14.15",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@types/uuid": "9.0.8",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.20",
    "concurrently": "8.2.2",
    "eslint": "8.57.1",
    "fast-check": "3.22.0",
    "postcss": "8.4.41",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "socket.io-client": "4.7.5",
    "supertest": "6.3.4",
    "tailwindcss": "3.4.10",
    "three": "0.168.0",
    "@types/three": "0.168.0",
    "tsx": "4.19.0",
    "typescript": "5.5.4",
    "vite": "5.4.3",
    "vitest": "1.6.0"
  }
}
